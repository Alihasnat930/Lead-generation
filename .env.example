# Free discovery requires no keys. These optional legacy connections are for outreach/CRM.
# Never commit credentials.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
SERPAPI_API_KEY=
APIFY_API_TOKEN=
APIFY_ACTOR=apify~google-maps-scraper
GOOGLE_SHEET_ID=
SERVICE_ACCOUNT_FILE=credentials/service_account.json
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
YOUR_NAME=Ali
LINKEDIN_URL=https://www.linkedin.com/in/syed-ali-hasnat-danyal-6b0a26246/
GITHUB_URL=
UPWORK_URL=
# Optional Discord completion notifications.
DISCORD_WEBHOOK_URL=
# Local password is optional. Hosted streamlit_app.py requires a password hash.
# scripts/prepare_release.py creates a private password and secrets template.
APP_LOGIN_PASSWORD_HASH=
# Supabase API keys. Use the new methods (recommended): secret + publishable.
# Legacy anon/service_role JWT names are also accepted for backward compatibility.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Alternative legacy names (either pair works):
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# Account login: email verification + approved workspace membership.
APP_AUTH_MODE=accounts
APP_ADMIN_EMAILS=owner@example.com
APP_PUBLIC_URL=http://localhost:8501
# Google OAuth web client. Redirect must be registered in Google Auth Platform.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501/oauth2callback
AUTH_COOKIE_SECRET=
# Optional provider integrations. Saving settings never sends messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# JSON string can replace the service-account file on a cloud host.
SERVICE_ACCOUNT_JSON=
DISCOVERY_JOB_ID=
